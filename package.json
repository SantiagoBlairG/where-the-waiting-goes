    "qa:contrast": "node .claude/skills/playwright-skill/run.js tests/qa/contrast.cjs",
    "qa:keyboard": "node .claude/skills/playwright-skill/run.js tests/qa/keyboard.cjs",
    "qa:perf": "node .claude/skills/playwright-skill/run.js tests/qa/perf.cjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.62.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
