    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
